# =============================================================================
# plaudeLM — Environment Variables
# Copy to .env and fill in all values before starting the stack.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333

# Test isolation — point to same instance, tests use prefixed collection names
TEST_QDRANT_URL=http://localhost:6333

# -----------------------------------------------------------------------------
# Neo4j
# NEO4J_AUTH format: username/password (used by the Neo4j container)
# NEO4J_URI: Bolt URI used by Python/TypeScript drivers
# -----------------------------------------------------------------------------
NEO4J_AUTH=neo4j/changeme
NEO4J_URI=bolt://neo4j:7687
NEO4J_HTTP_URL=http://neo4j:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Neo4j memory tuning (adjust for your home lab)
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512M

# Test isolation
TEST_NEO4J_URI=bolt://localhost:7687
TEST_NEO4J_USER=neo4j
TEST_NEO4J_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Kong AI Gateway — Konnect data plane (no local admin API)
# KONG_PROXY_URL: internal Docker network URL for services calling Kong
# When running integration tests from the HOST (outside Docker), override:
#   KONG_PROXY_URL=http://localhost:8000 npm run test:integration
# -----------------------------------------------------------------------------
KONG_PROXY_URL=http://kong:8000
KONG_LOG_LEVEL=warn

# -----------------------------------------------------------------------------
# LLM endpoints used by n8n ingest pipeline Code nodes
# Both route through Kong AI Gateway — Kong forwards to Azure OpenAI
# -----------------------------------------------------------------------------
CHAT_ENDPOINT=http://kong:8000/plaudelm/chat
EMBED_ENDPOINT=http://kong:8000/plaudelm/embed

# -----------------------------------------------------------------------------
# n8n Ingest Pipeline
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
N8N_HOST=localhost
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://n8n:5678/webhook

# n8n owner account — used by scripts/setup-n8n.sh to create the owner and activate workflows
# Password must be ≥8 chars with ≥1 uppercase letter
N8N_OWNER_EMAIL=paul@plaudelm.local
N8N_OWNER_FIRSTNAME=Paul
N8N_OWNER_LASTNAME=Admin
N8N_OWNER_PASSWORD=replace_with_secure_password

# Test isolation — n8n webhook reachable from host
TEST_N8N_WEBHOOK_URL=http://localhost:5678/webhook

# -----------------------------------------------------------------------------
# Query Service (FastAPI) — Spec #3
# -----------------------------------------------------------------------------
QUERY_SERVICE_URL=http://query:8000

# -----------------------------------------------------------------------------
# MCP Server — Spec #4
# -----------------------------------------------------------------------------
MCP_TRANSPORT=stdio
MCP_PORT=3000

# -----------------------------------------------------------------------------
# Kong MCP Gateway — Spec #5
# API key for the Kong consumer (paul) — used by all Claude clients
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
KONG_MCP_API_KEY=replace_with_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Audio Overview — Spec #7
# Directory where generated WAV files are saved (Docker volume mount)
# -----------------------------------------------------------------------------
AUDIO_OUTPUT_DIR=/data/audio

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
TZ=America/New_York
